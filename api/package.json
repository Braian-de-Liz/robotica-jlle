{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "dev": "bun --hot src/index.ts",
    "start": "bun dist/index.js",
    "comp": "bun build ./src/index.ts --minify --target=bun --outfile dist/index.js",
    "compT": "bun build ./src/index.ts --check --minify --target=bun --outfile dist/index.js",
    "check": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/autocannon": "7.12.7",
    "autocannon": "8.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
   "trustedDependencies": [
    "esbuild"
  ]
}